# ==============================================================================
# Shopwus Platform Environment Configuration
# ==============================================================================

# Application Base URLs & Branding
NEXT_PUBLIC_APP_NAME="Shopwus"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_DOMAIN="shopwus.com"

# WhatsApp Direct Lead Routing Default Phone
NEXT_PUBLIC_DEFAULT_STUDIO_PHONE="+2348055966944"

# API & Mock Data Configuration
# Set to 'true' to use client-side mock data + localStorage persistence.
# Set to 'false' when connecting to a production REST/GraphQL backend.
NEXT_PUBLIC_USE_MOCK_API="true"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"

# Production Backend / Database (Optional for Production Switch)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/shopwus"
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Cloud Storage (Optional for Production Media Uploads)
# CLOUDINARY_URL=""
# AWS_S3_BUCKET_NAME=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Google Business Profile & OAuth Integration
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
